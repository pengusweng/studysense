# Copy to etl/.env (gitignored). Defaults to the repo's Docker Postgres: run `docker compose up -d db`
# from the repo root first (host port 6000).
DATABASE_URL=postgresql://studysense:studysense@127.0.0.1:6000/studysense

# Used for DDL and COPY; the same database locally. For a hosted Postgres with a connection pooler, point this at
# the session-mode (non-transaction) connection.
DIRECT_URL=postgresql://studysense:studysense@127.0.0.1:6000/studysense
